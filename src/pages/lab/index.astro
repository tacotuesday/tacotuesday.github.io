---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedLab } from '../../lib/content';

const entries = publishedLab(await getCollection('lab'));
---

<BaseLayout
  title="Lab — Grafton Cook"
  description="Small independent apps, experiments and useful oddities built with public or synthetic data."
>
  <header class="shell page-hero compact-hero">
    <div>
      <p class="eyebrow">Lab / small useful software</p>
      <h1>Weekend apps, experiments and useful oddities.</h1>
      <p class="hero-summary">
        Independent, narrowly scoped tools. Standalone static apps live on their own GitHub project
        sites; this portfolio links out to them.
      </p>
    </div>
  </header>
  {
    entries.length > 0 && (
      <section class="shell section-pad" aria-labelledby="lab-index-title">
        <h2 id="lab-index-title" class="visually-hidden">
          Published Lab entries
        </h2>
        <div class="lab-index">
          {entries.map((entry) => (
            <article>
              {entry.data.cover && (
                <a
                  class="lab-index-cover"
                  href={entry.data.appUrl ?? entry.data.repositoryUrl}
                  aria-label={`Open ${entry.data.title}`}
                >
                  <img
                    src={entry.data.cover.image}
                    alt={entry.data.cover.alt}
                    width="1200"
                    height="631"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="lab-index-copy">
                <p class="meta">
                  {entry.data.status} · {entry.data.technologies.join(' + ')}
                </p>
                <h2>{entry.data.title}</h2>
                <p>{entry.data.description}</p>
                <div class="actions">
                  {entry.data.appUrl && (
                    <a class="button" href={entry.data.appUrl}>
                      Open app ↗
                    </a>
                  )}
                  {entry.data.repositoryUrl && (
                    <a class="text-link" href={entry.data.repositoryUrl}>
                      Repository ↗
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
