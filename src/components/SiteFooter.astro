    <nav aria-label="Footer navigation">
      <ul class="footer-links">
        <li><a href={siteConfig.github} rel="me">GitHub</a></li>
        <li><a href={siteConfig.linkedin} rel="me">LinkedIn</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <p class="copyright">© {year} Grafton Cook</p>
  </div>
</footer>
