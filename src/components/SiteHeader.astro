---
interface NavItem {
  href: string;
  label: string;
}

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Grafton Cook, home">
      <span>Grafton Cook</span>
      <small>forecasting · decisions · systems</small>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
